{
  "name": "sustech-campus-assistant",
  "version": "0.0.0-internal",
  "private": true,
  "description": "SUSTech campus academic assistant for deadlines, course support, policy search, course recommendation, and campus news",
  "author": "Huang, Zhu, Dong, Zhou, Wang",
  "contributors": [
    "Zhengdong Huang",
    "Chao Zhu",
    "Wanxi Dong",
    "Shengli Zhou",
    "Taojie Wang"
  ],
  "license": "Apache-2.0",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "tsc -p tsconfig.json || pnpm --dir ../gui exec tsc -p ../desktop/tsconfig.json",
    "test:unit": "npm run build:main && node src/env.test.mjs && node src/backend.test.mjs",
    "dev": "npm run build:main && electron .",
    "dist": "npm run build:main && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.3"
  },
  "build": {
    "extends": "./electron-builder.yml"
  }
}
