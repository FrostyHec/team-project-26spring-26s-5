# =============================================================================
# Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# LLM Configuration
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.0

# Agent Configuration
MAX_ITERATIONS=10
SYSTEM_PROMPT=You are a helpful AI assistant with calculator tools.

# Logging Configuration
# LOG_LEVEL: 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
#   - DEBUG: 最详细的日志，包含完整的 LLM 提示词、工具输入/输出、每一步的推理过程。用于开发和调试。
#   - INFO: 默认级别，记录主要步骤和重要信息。
#   - WARNING: 仅记录警告和错误。
LOG_LEVEL=INFO

# LOG_FILE: 日志输出目标
#   - 留空或不设置：日志仅输出到控制台（stdout）
#   - 指定文件路径（如 "agent.log"）：日志输出到指定文件。可使用相对路径（相对于运行目录）或绝对路径。
#   - 例如：
#     LOG_FILE=agent.log          # 在当前工作目录下创建/写入 agent.log
#     LOG_FILE=/var/log/agent.log # 写入到绝对路径（需要该目录存在）
#     LOG_FILE=./logs/debug.log    # 在当前目录的 logs 子目录下创建日志文件
LOG_FILE=

# Database Configuration
# DB_PATH: SQLite 数据库文件路径，用于持久化会话和消息记录
#   - 默认值：./output/sessions.db
#   - 使用相对路径时，相对于运行目录
#   - 目录不存在时会自动创建
#   - 例如：
#     DB_PATH=./output/sessions.db  # 默认路径
#     DB_PATH=:memory:              # 内存数据库（测试用，重启后数据丢失）
DB_PATH=./output/sessions.db
