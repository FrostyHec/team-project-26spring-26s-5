# =============================================================================
# Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# Logging Configuration
# LOG_LEVEL: 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
#   - DEBUG: 最详细的日志，包含完整的 LLM 提示词、工具输入/输出、每一步的推理过程。用于开发和调试。
#   - INFO: 默认级别，记录主要步骤和重要信息。
#   - WARNING: 仅记录警告和错误。
LOG_LEVEL=INFO

# Runtime data root
# Most writable runtime files derive from DATA_PATH by default.
DATA_PATH=./output

# Application server configuration
# APP_HOST defaults to 127.0.0.1 for local packaged applications.
# APP_PORT controls both browser and desktop-window access.
APP_HOST=127.0.0.1
APP_PORT=8000

# Course Material Configuration
# COURSE_MATERIAL_MAX_SIZE_MB: 上传文件大小上限（MB），默认 10
# COURSE_MATERIAL_ALLOWED_EXTENSIONS: 允许的文件扩展名，逗号分隔，默认 .pdf,.docx,.pptx,.xlsx,.txt,.md
COURSE_MATERIAL_MAX_SIZE_MB=10
COURSE_MATERIAL_ALLOWED_EXTENSIONS=.pdf,.docx,.pptx,.xlsx,.txt,.md

# =============================================================================
# Embedding Configuration (for Policy Search RAG)
# =============================================================================
# Uses DashScope OpenAI-compatible endpoint by default
EMBEDDING_API_KEY=your-dashscope-api-key-here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# =============================================================================
# Policy Search Index Configuration
# =============================================================================
# Leave paths blank to derive from DATA_PATH:
#   POLICY_PDF_DIR=${DATA_PATH}/pdfs
#   POLICY_INDEX_DIR=${DATA_PATH}/policy_index
POLICY_PDF_DIR=
POLICY_INDEX_DIR=
POLICY_CHUNK_SIZE=500
POLICY_CHUNK_OVERLAP=100

# =============================================================================
# Advanced Path Overrides
# =============================================================================
# 推荐保持以下路径项为空，让程序自动从 DATA_PATH 派生默认值。
# 只有在需要把数据库、日志或 LLM 设置文件拆到独立位置时才手动配置。

# DB_PATH: SQLite database directory. Blank default: ${DATA_PATH}
# Runtime databases are created as fixed filenames under this directory:
#   sessions.db, courses.db, course_materials.db, email.db, deadlines.db
# Use :memory: only for tests or temporary sessions.
DB_PATH=

# LOG_FILE: log output file. Blank default: ${DATA_PATH}/logs/agent.log
# Relative paths are resolved from the .env file directory when --env-file is used.
LOG_FILE=

# LLM_SETTINGS_PATH: YAML-backed provider/settings file.
# Blank default: ${DATA_PATH}/llm_settings.yaml
LLM_SETTINGS_PATH=
